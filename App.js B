// =====================================
// FILE UPLOAD
// Matches server.py /upload
// =====================================


async function uploadFile(){


    const file =
    document
    .getElementById("file")
    .files[0];



    if(!file){

        return;

    }




    const formData =
    new FormData();



    formData.append(

        "file",

        file

    );




    const response =
    await fetch(

        `${API_URL}/upload`,

        {

            method:"POST",

            body:formData

        }

    );




    const data =
    await response.json();




    socket.send(

        JSON.stringify({

            type:"file",

            receiver:selectedUser,

            filename:data.filename,

            url:data.url,

            file_type:data.type


        })

    );



}









